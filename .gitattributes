# Large binary and bulk-numeric assets go through Git LFS.
# Install once:  git lfs install
*.csv   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.pptx  filter=lfs diff=lfs merge=lfs -text

# Keep line endings sane across contributors
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.xacro text eol=lf
*.db3 filter=lfs diff=lfs merge=lfs -text

# These legacy files are ordinary Git blobs. Preserve their existing storage
